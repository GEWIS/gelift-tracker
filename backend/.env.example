# SQLite (default): file path. PostgreSQL: set DATABASE_URL or DATABASE_DRIVER=postgres and a libpq-style DSN.
DATABASE=local.sqlite
# DATABASE_DRIVER=auto   # auto (default): postgres if DATABASE_URL set, else sqlite
# DATABASE_DRIVER=sqlite
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/gelift?sslmode=disable
MQTT_URL=mqtts://gelift.example:8883
MQTT_USERNAME=svc-gelift
MQTT_PASSWORD=